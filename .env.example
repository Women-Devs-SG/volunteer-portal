# Copy this file to .env for local development (`npm run dev`).
# In production these are set in the Netlify UI, NOT in a committed file.
# Do not commit .env.

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# Leave this at 1 to run the portal with fictional data from
# fixtures/tasks.demo.json. Nothing below is needed, no Google or Telegram call
# is made, and any password unlocks the portal.
#
# NEVER set DEMO_MODE in the Netlify production context. The API refuses every
# request if you do, on purpose — volunteers must never be shown fake data.
#
# Set it to 0 (or delete it) to run against real Google credentials.
DEMO_MODE=1

# ---------------------------------------------------------------------------
# Real credentials — only needed when DEMO_MODE is off
# ---------------------------------------------------------------------------

# Shared portal password for real integrations. The API refuses requests if it
# is unset, so the portal can never silently run unprotected.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PORTAL_PASSWORD=

GOOGLE_CLIENT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_DRIVE_PARENT_FOLDER_ID=your-google-drive-parent-folder-id
WDS_INTRO_DOC_ID=your-google-doc-id
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
