# Copy this file to .env for local development (`npm run dev`).
# In production these are set in the Netlify UI, NOT in a committed file.
# Do not commit .env.

# Shared portal password. Must be at least 12 characters — the API refuses all
# requests if it is unset or shorter, so it can never silently run unprotected.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
PORTAL_PASSWORD=

GOOGLE_CLIENT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_CONTENT_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id
GOOGLE_DRIVE_PARENT_FOLDER_ID=your-google-drive-parent-folder-id
WDS_INTRO_DOC_ID=your-google-doc-id
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
